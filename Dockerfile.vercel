FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions \
        intl \
        zip \
        bcmath \
        pdo_mysql \
        pdo_sqlite \
        pcntl \
        opcache

WORKDIR /app

FROM node:22-bookworm AS frontend

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

COPY . .
COPY --from=frontend /app/public/build /app/public/build

# Demo key baked into the image so Vercel runs without external secrets.
# Override APP_KEY in Vercel if you want a private key.
ENV APP_KEY=base64:jhy2XeXMVioryYjMHhGf8jPtWmiHCrfJG2BzhBet3Rw= \
    APP_ENV=production \
    APP_DEBUG=false \
    DB_CONNECTION=sqlite \
    DB_DATABASE=/app/database/database.sqlite \
    CACHE_STORE=array \
    SESSION_DRIVER=cookie \
    QUEUE_CONNECTION=sync \
    LOG_CHANNEL=stderr \
    LOG_STACK=single

RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        storage/app/public \
        bootstrap/cache \
        database \
    && touch database/database.sqlite \
    && composer dump-autoload --no-dev --optimize \
    && php artisan package:discover --ansi \
    && php artisan migrate --force --no-interaction \
    && php artisan db:seed --force --no-interaction \
    && php artisan event:cache \
    && php artisan view:cache \
    && chown -R www-data:www-data /app/storage /app/bootstrap/cache /app/database

FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile
COPY --chmod=755 vercel-entrypoint.sh /app/vercel-entrypoint.sh

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy /app/database

ENV PORT=80 \
    APP_NAME="Kabar Banten" \
    APP_ENV=production \
    APP_DEBUG=false \
    APP_KEY=base64:jhy2XeXMVioryYjMHhGf8jPtWmiHCrfJG2BzhBet3Rw= \
    APP_URL=https://kabarbanten-keuangan.vercel.app \
    DB_CONNECTION=sqlite \
    DB_DATABASE=/app/database/database.sqlite \
    LOG_CHANNEL=stderr \
    LOG_STACK=single \
    CACHE_STORE=array \
    SESSION_DRIVER=cookie \
    QUEUE_CONNECTION=sync

USER www-data

CMD ["/app/vercel-entrypoint.sh"]
