# Salin nilai ini ke Vercel → Project → Settings → Environment Variables
# (Production). Setelah diubah, Redeploy wajib.

APP_NAME=Kabar Banten
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kbanten-keuangan.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Database eksternal WAJIB (Vercel tidak punya MySQL)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=copyacurate
DB_USERNAME=root
DB_PASSWORD=200122

# Setelah DB siap + migrate, ganti ke database:
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=array
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@kabarbanten.test
MAIL_FROM_NAME=Kabar Banten
