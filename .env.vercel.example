# Opsional di Vercel. Image sudah berisi SQLite + data demo + APP_KEY.
# Hapus env DB_* lama (DB_HOST=mysql, dll) supaya tidak menimpa SQLite.

APP_URL=https://kbanten-keuangan.vercel.app
APP_NAME=Kabar Banten
APP_ENV=production
APP_DEBUG=false

# Jangan set DB_CONNECTION=mysql / DB_HOST=mysql di Vercel.
# Default image: SQLite di /app/database/database.sqlite
